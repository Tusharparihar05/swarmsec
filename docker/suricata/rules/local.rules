#alert icmp any any -> any any (msg:"ICMP Packet Detected - Suricata Test"; sid:1000001; rev:1;)
alert tcp any any -> any any (flags:S; msg:"Possible TCP SYN Scan Detected"; detection_filter:track by_src, count 5, seconds 3; sid:1000002; rev:1;)

# API Abuse - SQL Injection attempts
alert http any any -> any any (msg:"SQL Injection Attempt Detected"; content:"SELECT"; nocase; content:"FROM"; nocase; distance:0; sid:1000003; rev:1;)

# API Abuse - XSS Attack
alert http any any -> any any (msg:"XSS Attack Detected"; content:"<script>"; nocase; sid:1000004; rev:1;)

# Reverse Shell - Suspicious outbound shell command
alert tcp any any -> any any (msg:"Possible Reverse Shell Detected"; flow:established; content:"/bin/sh"; nocase; sid:1000005; rev:1;)

# ARP Spoofing Detection
alert arp any any -> any any (msg:"ARP Spoofing Detected"; sid:1000006; rev:1;)
