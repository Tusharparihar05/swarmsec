# SwarmSec Environment Configuration
# Copy to .env and fill in your values

# Groq API Key (FREE - get from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_key_here

# Neo4j (Docker container)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=swarmsecpass

# Redis (Docker container)
REDIS_HOST=localhost
REDIS_PORT=6379

# MongoDB (Docker container)
MONGO_URI=mongodb://localhost:27017

# Suricata eve.json path (absolute path recommended)
# EVE_LOG_PATH=/Users/yourname/Desktop/College/Major Project/swarmsec/docker/suricata/logs/eve.json

# Set to true to skip LLM calls (for testing without API key)
# MOCK_LLM=false
